#!/usr/bin/env bash
# kirara — open Kirara (the endless Japanese quiz) as a normal niri app (app-id "kirara"),
# or focus it when it is already running. Close it like any window (Mod+Q).
# Env: KIRARA_APP / KIRARA_TITLE / KIRARA_APP_ID (the pre-rename JPQUIZ_* names still work).
APP="${KIRARA_APP:-${JPQUIZ_APP:-$HOME/.local/share/kirara/app}}"
TITLE="${KIRARA_TITLE:-${JPQUIZ_TITLE:-Kirara}}"
APP_ID="${KIRARA_APP_ID:-${JPQUIZ_APP_ID:-kirara}}"
# Already open? Focus it (shared helper ~/.local/bin/niri-focus-or-run: app-id + exact title).
FOCUS=$(command -v niri-focus-or-run || echo "$HOME/.local/bin/niri-focus-or-run")
if [ -x "$FOCUS" ] && "$FOCUS" --title "$TITLE" "$APP_ID"; then exit 0; fi
# QS_APP_ID makes quickshell use this as the Wayland xdg-toplevel app-id (default org.quickshell).
export KIRARA_APP="$APP" KIRARA_TITLE="$TITLE" QS_APP_ID="$APP_ID"
exec quickshell -n -p "$APP/qml" "$@"
